# Kalshi API credentials. Copy to `.env` and fill in. `.env` is gitignored.
#
# These are read ONLY by the local pmxt-core server (localhost:3847), which runs
# on your machine and makes the actual signed requests to Kalshi. They are never
# passed through the agent / LLM and never sent to pmxt.dev.
#
# Generate an API key + RSA key pair in the Kalshi web UI:
#   Account -> Profile -> API Keys -> Create. You get a Key ID and download a
#   PEM private key (the private key is shown only once).

# The Kalshi "API Key ID" (a UUID).
KALSHI_API_KEY=00000000-0000-0000-0000-000000000000

# The RSA private key PEM, as a SINGLE line with literal "\n" between each line.
# pmxt converts the "\n" sequences back into real newlines before signing.
# To produce this from a downloaded key file:
#   awk 'BEGIN{ORS="\\n"}1' kalshi-private-key.pem
KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n...\n-----END RSA PRIVATE KEY-----"

# Production trades require a PRODUCTION key (api.elections.kalshi.com).
# The kalshi-demo paper-trading sandbox (demo-api.kalshi.co) requires a SEPARATE
# demo-account key. If you want to test against demo, create a key in the Kalshi
# demo environment and put it here; otherwise only the live `kalshi` exchange works.
